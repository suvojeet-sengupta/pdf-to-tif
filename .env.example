# ── access ────────────────────────────────────────────────────────────────
# Shared password for the web UI. Required unless ALLOW_NO_PASSWORD=true.
APP_PASSWORD=change-me
# Acknowledge running with no password (only behind Cloudflare Access / VPN).
ALLOW_NO_PASSWORD=false
# Signs session cookies. Generate with: openssl rand -hex 32
# Without it sessions are dropped on every restart.
SESSION_SECRET=
# Days-equivalent in hours that a login stays valid.
SESSION_TTL_HOURS=336
# Set false only if you reach the app over plain http:// (no TLS).
COOKIE_SECURE=true

# ── server ────────────────────────────────────────────────────────────────
PORT=9000
DATA_DIR=/data
APP_NAME=Pagesmith

# ── conversion limits ─────────────────────────────────────────────────────
# Parallel page renderers. Unset = min(8, CPU cores).
# RENDER_WORKERS=4
MAX_CONCURRENT_JOBS=1
MAX_BATCH_FILES=5
# RENDER_MEMORY_MB=2400
MAX_UPLOAD_MB=500
MAX_PAGES=10000
JOB_TTL_MINUTES=120
DEFAULT_DPI=200
MAX_DPI=600
LIBRARY_LIMIT=40

# ── chunked uploads ──────────────────────────────────────────────────────
# Each chunk is this many MB. 4 MB stays well under Cloudflare's 100 MB cap.
UPLOAD_CHUNK_MB=4
# Incomplete uploads are cleaned up after this many minutes of inactivity.
UPLOAD_TTL_MINUTES=180

# ── large-document safety ────────────────────────────────────────────────
# Render tasks queued per worker process (sliding window).
# INFLIGHT_PER_WORKER=3
# Abort if free disk drops below this (MB).
# MIN_FREE_DISK_MB=1024
# Scale down pages exceeding this pixel count instead of OOM-ing the worker.
# MAX_PAGE_PIXELS=120000000
